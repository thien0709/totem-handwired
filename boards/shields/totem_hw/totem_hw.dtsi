#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row"; 

        // KHAI BÁO CỘT (Hàn bên TRÁI chip SuperMini)
        col-gpios
            = <&gpio0 6  GPIO_ACTIVE_HIGH> // Col 0: Chân 006
            , <&gpio0 8  GPIO_ACTIVE_HIGH> // Col 1: Chân 008
            , <&gpio0 17 GPIO_ACTIVE_HIGH> // Col 2: Chân 017
            , <&gpio0 20 GPIO_ACTIVE_HIGH> // Col 3: Chân 020
            , <&gpio0 22 GPIO_ACTIVE_HIGH> // Col 4: Chân 022
            ;

        // KHAI BÁO HÀNG (Hàn bên PHẢI chip SuperMini)
        row-gpios
            = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 0: Chân 031
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 1: Chân 029
            , <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 2: Chân 002
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 3: Chân 115 (Lưu ý gpio1)
            ;
    };

default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>; 
        rows = <4>;

    map = <
        // TAY TRÁI (0-4)                          // TAY PHẢI (5-9)
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
        RC(3,0) RC(3,2) RC(3,3) RC(3,4)            RC(3,5) RC(3,7) RC(3,8) RC(3,9)
        >;
    };
};