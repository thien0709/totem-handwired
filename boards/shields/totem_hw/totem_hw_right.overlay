#include "totem_hw.dtsi"

&default_transform {
    col-offset = <5>;
};

&kscan_matrix {
    col-gpios
        = <&gpio0 31 GPIO_ACTIVE_HIGH>
        , <&gpio0 29 GPIO_ACTIVE_HIGH>
        , <&gpio0 2  GPIO_ACTIVE_HIGH> 
        , <&gpio1 15 GPIO_ACTIVE_HIGH> 
        , <&gpio1 13 GPIO_ACTIVE_HIGH> 
        ;
};

&kscan_direct {
    // 5 chân tín hiệu của Công tắc 5 hướng.
    input-gpios 
        = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Chân 111
        , <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Chân 010
        , <&gpio0 9  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Chân 009
        , <&gpio1 0  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Chân 100
        , <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Chân 011
        ;
};