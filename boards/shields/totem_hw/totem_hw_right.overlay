#include "totem_hw.dtsi"

&default_transform {
    col-offset = <5>;
};

&right_encoder {
    status = "okay";
};

// Map nút direct (encoder button) bên phải vào đúng vị trí logic
&kscan_direct {
    input-gpios = <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    // ZMK tự động xử lý offset cho kscan composite dựa trên thứ tự, 
    // nhưng với split handwired đôi khi cần config kỹ. 
    // Tạm thời cấu hình này sẽ nhận nút phải như một nút direct riêng biệt.
};