#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Định nghĩa lại tên và số thứ tự Layer cho gọn
#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    // Cấu hình Combo: Bấm J + K cùng lúc để thoát (Esc)
    // Rất tiện khi đang code mà lười với ngón tay lên góc
    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <50>;
            key-positions = <16 17>; // Vị trí phím J và K
            bindings = <&kp ESC>;
        };
    };

    // Logic: Giữ NAV (Lớp 1) + Giữ SYM (Lớp 2) = Tự động vào lớp ADJ (Lớp 3)
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <ADJ>;
        };
    };

    behaviors {
        // Giữ = Ctrl, Nhấp = Esc (Dành cho ngón cái trái - Siêu tốc cho Vim)
        mt_ctrl_esc: mt_ctrl_esc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        // Giữ = Shift, Nhấp = Enter (Dành cho ngón cái phải)
        mt_shift_ret: mt_shift_ret {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

/*
 * LAYER 0: BASE (QWERTY for Coding)
 *
 * Q    W    E    R    T     |     Y    U    I    O    P
 * A    S    D    F    G     |     H    J    K    L    ;
 * Z    X    C    V    B     |     N    M    ,    .    /
 * ESC/CTL NAV  SPACE        |    ENT  SYM  BSPC
 *
 * (Lưu ý: Hàng dưới cùng đã tối ưu cho ngón cái)
 */
        base_layer {
            display-name = "Base";
            bindings = <
    &kp Q          &kp W      &kp E       &kp R       &kp T           &kp Y      &kp U      &kp I       &kp O      &kp P
    &kp A          &kp S      &kp D       &kp F       &kp G           &kp H      &kp J      &kp K       &kp L      &kp SEMI
    &kp Z          &kp X      &kp C       &kp V       &kp B           &kp N      &kp M      &kp COMMA   &kp DOT    &kp FSLH
                   &mt_ctrl_esc LCTRL  &mo NAV     &kp SPACE       &mt_shift_ret RSHIFT RET    &mo SYM    &kp BSPC
    &kp C_MUTE &kp C_PP
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

/*
 * LAYER 1: NAV (Navigation & Numbers) - Giữ ngón cái TRÁI
 *
 * 1    2    3    4    5     |     6    7    8    9    0
 * .    .    .    .    .     |     LEFT DOWN UP   RIGHT : (Hai chấm)
 * .    .    .    .    .     |     HOME PGDN PGUP END   \
 * .    .    .               |     .    .    DEL
 */
        nav_layer {
            display-name = "Nav";
            bindings = <
    &kp N1     &kp N2     &kp N3      &kp N4      &kp N5          &kp N6     &kp N7     &kp N8      &kp N9     &kp N0
    &trans     &trans     &trans      &trans      &trans          &kp LEFT   &kp DOWN   &kp UP      &kp RIGHT  &kp COLON
    &trans     &trans     &trans      &trans      &trans          &kp HOME   &kp PG_DN  &kp PG_UP   &kp END    &kp BSLH
                          &trans      &trans      &trans          &trans     &trans     &kp DEL
    &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

/*
 * LAYER 2: SYM (Symbols) - Giữ ngón cái PHẢI
 *
 * !    @    #    $    %     |     ^    &    * (    )
 * ~    -    +    =    _     |     {    }    [    ]    '
 * `    .    .    .    .     |     <    >    .    .    "
 * .    .    .               |     .    .    .
 */
        sym_layer {
            display-name = "Sym";
            bindings = <
    &kp EXCL   &kp AT     &kp HASH    &kp DLLR    &kp PRCNT       &kp CARET  &kp AMPS   &kp STAR    &kp LPAR   &kp RPAR
    &kp TILDE  &kp MINUS  &kp PLUS    &kp EQUAL   &kp UNDER       &kp LBRC   &kp RBRC   &kp LBKT    &kp RBKT   &kp SQT
    &kp GRAVE  &trans     &trans      &trans      &trans          &kp LT     &kp GT     &trans      &trans     &kp DQT
                          &trans      &trans      &trans          &trans     &trans     &trans
    &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

/*
 * LAYER 3: ADJ (System) - Giữ CẢ 2 ngón cái
 *
 * F1   F2   F3   F4   F5    |     F6   F7   F8   F9   F10
 * BTCLR BT0 BT1  BT2  BT3   |    OUT  .    .    .    F11
 * RESET .   .    .    .     |    .    .    .    .    F12
 * .    .    .               |    .    .    .
 */
        adj_layer {
            display-name = "Adj";
            bindings = <
    &kp F1        &kp F2        &kp F3        &kp F4        &kp F5           &kp F6        &kp F7        &kp F8        &kp F9        &kp F10
    &bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3     &out OUT_TOG  &trans        &trans        &trans        &kp F11
    &sys_reset    &trans        &trans        &trans        &trans           &trans        &trans        &trans        &trans        &kp F12
                                &trans        &trans        &trans           &trans        &trans        &trans
    &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };
    };
};