#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/* ===================== LAYERS ===================== */
#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    /* ===================== COMBOS ===================== */
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <70>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_del {
            timeout-ms = <70>;
            key-positions = <8 9>;
            bindings = <&kp DEL>;
        };
    };

    /* ===================== TRI LAYER ===================== */
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <ADJ>;
        };
    };

    /* ===================== HOLD-TAP TUNING ===================== */
    &lt {
        flavor = "tap-preferred";
        tapping-term-ms = <130>;
        quick-tap-ms = <90>;
        global-quick-tap;
    };

    /* ===================== ENCODERS ===================== */
    behaviors {
        scroll_vert {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_WH_UP>, <&kp C_WH_DOWN>;
        };

        scroll_hor {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_WH_LEFT>, <&kp C_WH_RIGHT>;
        };
    };

    /* ===================== KEYMAP ===================== */
    keymap {
        compatible = "zmk,keymap";

        /* =================================================
         * BASE LAYER
         *
         * Q  W  E  R  T      Y  U  I  O  P
         * A  S  D  F  G      H  J  K  L  ;
         * Z  X  C  V  B      N  M  ,  .  /
         *
         *      Ctrl Gui [NAV/Spc] [SYM/Ent]
         *      Bspc Alt  Del       Shift
         * ================================================= */
        base_layer {
            display-name = "Base";

            bindings = <
                &kp Q      &kp W      &kp E      &kp R      &kp T
                &kp A      &kp S      &kp D      &kp F      &kp G
                &kp Z      &kp X      &kp C      &kp V      &kp B

                &kp Y      &kp U      &kp I      &kp O      &kp P
                &kp H      &kp J      &kp K      &kp L      &kp SEMI
                &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH

                &kp LCTRL  &kp LGUI   &lt NAV SPACE   &lt SYM RET
                &kp BSPC   &kp RALT   &kp DEL        &kp RSHFT
            >;

            sensor-bindings = <&scroll_vert &scroll_hor>;
        };

        /* ===================== NAV ===================== */
        nav_layer {
            display-name = "Nav";

            bindings = <
                &trans &kp N7 &kp N8 &kp N9 &kp N0
                &trans &kp N4 &kp N5 &kp N6 &trans
                &trans &kp N1 &kp N2 &kp N3 &kp DOT

                &kp PG_UP &kp HOME &kp UP   &kp END &trans
                &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &trans
                &trans &trans &trans &trans &trans

                &trans &trans &trans &trans
            >;
        };

        /* ===================== SYMBOL ===================== */
        sym_layer {
            display-name = "Sym";

            bindings = <
                &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT
                &kp TILDE &kp MINUS &kp PLUS &kp EQUAL &kp UNDER
                &kp GRAVE &trans   &trans   &trans   &trans

                &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR
                &kp LBRC  &kp RBRC &kp LBKT &kp RBKT &kp SQT
                &kp LT    &kp GT   &trans   &trans   &kp DQT

                &trans &trans &trans &trans
            >;
        };

        /* ===================== ADJUST ===================== */
        adj_layer {
            display-name = "Adj";

            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3
                &sys_reset &trans &trans &trans &trans

                &kp F6 &kp F7 &kp F8 &kp F9 &kp F10
                &trans &trans &trans &trans &kp F11
                &trans &trans &trans &trans &kp F12

                &trans &trans &trans &trans
            >;
        };
    };
};
