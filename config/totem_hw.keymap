#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define COLEMAK 1
#define GAMING  2
#define LOWER   3
#define RAISE   4
#define ADJUST  5
#define FKEYS   6

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    behaviors {
        td_caps: tap_dance_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPS>;
        };
        mt_ctrl_esc: mt_ctrl_esc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(S))>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // LƯU Ý: Totem chỉ có 5 cột mỗi bên, nên mình đã bỏ TAB và BSPC ở 2 rìa
        // TAB và BSPC sẽ được đưa xuống ngón cái hoặc layer khác
        default_layer {
            display-name = "QWERTY";
            bindings = <
    &kp Q      &kp W      &kp E       &kp R       &kp T           &kp Y      &kp U      &kp I       &kp O      &kp P
    &kp A      &kp S      &kp D       &kp F       &kp G           &kp H      &kp J      &kp K       &kp L      &kp SEMI
    &kp Z      &kp X      &kp C       &kp V       &kp B           &kp N      &kp M      &kp COMMA   &kp DOT    &kp FSLH
                          &kp LCTRL   &mo LOWER   &kp SPACE       &kp RET    &mo RAISE  &kp BSPC
    // Hàng Encoder (Nếu bạn có dùng nút click)
    &kp C_MUTE &kp C_PP 
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        colemak_layer {
            display-name = "Colemak";
            bindings = <
    &kp Q      &kp W      &kp F       &kp P       &kp B           &kp J      &kp L      &kp U       &kp Y      &kp SEMI
    &kp A      &kp R      &kp S       &kp T       &kp G           &kp M      &kp N      &kp E       &kp I      &kp O
    &kp Z      &kp X      &kp C       &kp D       &kp V           &kp K      &kp H      &kp COMMA   &kp DOT    &kp FSLH
                          &kp LCTRL   &mo LOWER   &kp SPACE       &kp RET    &mo RAISE  &kp BSPC
    &kp C_MUTE &kp C_PP
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        gaming_layer {
            display-name = "Gaming";
            bindings = <
    &kp Q      &kp W      &kp E       &kp R       &kp T           &kp Y      &kp U      &kp I       &kp O      &kp P
    &kp A      &kp S      &kp D       &kp F       &kp G           &kp H      &kp J      &kp K       &kp L      &kp SEMI
    &kp Z      &kp X      &kp C       &kp V       &kp B           &kp N      &kp M      &kp COMMA   &kp DOT    &kp FSLH
                          &kp LCTRL   &mo LOWER   &kp SPACE       &kp RET    &mo RAISE  &kp BSPC
    &kp C_MUTE &kp C_PP
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "Number";
            bindings = <
    &kp N1     &kp N2     &kp N3      &kp N4      &kp N5          &kp N6     &kp N7     &kp N8      &kp N9     &kp N0
    &trans     &trans     &trans      &trans      &trans          &kp LEFT   &kp DOWN   &kp UP      &kp RIGHT  &kp PG_UP
    &kp LG(Z)  &kp LG(X)  &kp LG(C)   &kp LG(V)   &kp LG(A)       &kp HOME   &kp END    &trans      &trans     &kp PG_DN
                          &trans      &trans      &trans          &trans     &trans     &trans
    &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            display-name = "Symbol";
            bindings = <
    &kp EXCL   &kp AT     &kp HASH    &kp DLLR    &kp PRCNT       &kp CARET  &kp AMPS   &kp STAR    &kp LPAR   &kp RPAR
    &trans     &trans     &trans      &trans      &trans          &kp MINUS  &kp EQUAL  &kp LBKT    &kp RBKT   &kp BSLH
    &trans     &trans     &trans      &trans      &trans          &kp UNDER  &kp PLUS   &kp LBRC    &kp RBRC   &kp GRAVE
                          &trans      &trans      &trans          &trans     &trans     &trans
    &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            display-name = "System";
            bindings = <
    &kp F1        &kp F2        &kp F3        &kp F4        &kp F5           &kp F6        &kp F7        &kp F8        &kp F9        &kp F10
    &bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3     &out OUT_TOG  &trans        &trans        &trans        &kp F11
    &sys_reset    &trans        &trans        &trans        &trans           &trans        &trans        &trans        &trans        &kp F12
                                &trans        &trans        &trans           &trans        &trans        &trans
    &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };
        
    };
};