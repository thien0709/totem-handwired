#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    combos {
        compatible = "zmk,combos";
        // Combo bấm Q + W ra ESC (giữ nguyên phòng khi cần thiết)
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>; 
            bindings = <&kp ESC>;
        };
    };

    // Tự động chuyển sang ADJ layer nếu giữ cả phím NAV (Space) và SYM (Enter)
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <ADJ>;
        };
    };

    behaviors {
        // Tối ưu cho phím vừa giữ vừa bấm (Dành cho Space, Enter)
        lt_opt: layer_tap_optimized {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };

        // Tối ưu cho phím Mod (Dành cho ALT/TAB, ALT/BSPC)
        mt_opt: mod_tap_optimized {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        // Cấu hình cuộn mượt cho Roller Encoder
        scroll_smooth: scroll_smooth {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&macro_scroll_up>, <&macro_scroll_down>;
        };
    };

    macros {
        macro_scroll_up: macro_scroll_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp UP &kp UP &kp UP>;
        };
        
        macro_scroll_down: macro_scroll_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp DOWN &kp DOWN &kp DOWN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
    // ROW 1
    &kp Q      &kp W      &kp E       &kp R       &kp T            &kp Y       &kp U      &kp I      &kp O      &kp P
    // ROW 2
    &kp A      &kp S      &kp D       &kp F       &kp G            &kp H       &kp J      &kp K      &kp L      &kp SEMI
    // ROW 3
    &kp Z      &kp X      &kp C       &kp V       &kp B            &kp N       &kp M      &kp COMMA  &kp DOT    &kp FSLH
    // ROW 4: Phím sườn ngón út (LCTRL) + 3 ngón cái TRÁI  ||  3 ngón cái PHẢI + Phím sườn ngón út (RSHFT)
    &kp LCTRL  &kp LGUI   &mt_opt LALT TAB  &lt_opt NAV SPACE      &lt_opt SYM RET &mt_opt RALT BSPC &kp DEL &kp RSHFT
    // ROW 5: Ấn Roller Encoder (Trái)  ||  Cụm 5 hướng (Phải: Lên, Trái, Xuống, Giữa, Phải)
    &kp C_MUTE                                                                 &kp UP     &kp LEFT   &kp DOWN   &kp RET    &kp RIGHT
            >;
            // Xoay Encoder: Tăng giảm âm lượng
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
    &trans     &kp N7     &kp N8     &kp N9      &kp N0           &kp PG_UP  &kp HOME   &kp UP     &kp END    &trans
    &trans     &kp N4     &kp N5     &kp N6      &trans           &kp PG_DN  &kp LEFT   &kp DOWN   &kp RIGHT  &kp COLON
    &trans     &trans     &kp N1     &kp N2      &kp N3           &kp DOT    &trans     &trans     &trans     &trans
    &trans     &trans     &trans     &trans                       &trans     &trans     &kp DEL    &trans
    &kp C_PP                                                                 &trans     &trans     &trans     &trans     &trans
            >;
            // Xoay Encoder: Cuộn mượt (Scroll)
            sensor-bindings = <&scroll_smooth>;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
    &kp EXCL   &kp AT     &kp HASH   &kp DLLR    &kp PRCNT        &kp CARET  &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR
    &kp TILDE  &kp MINUS  &kp PLUS   &kp EQUAL   &kp UNDER        &kp LBRC   &kp RBRC   &kp LBKT   &kp RBKT   &kp SQT
    &trans     &trans     &trans     &trans      &trans           &kp LT     &kp GT     &trans     &trans     &kp DQT
    &kp GRAVE  &trans     &trans     &trans                       &trans     &trans     &trans     &trans
    &trans                                                                   &trans     &trans     &trans     &trans     &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        adj_layer {
            display-name = "Adj";
            bindings = <
    &kp F1     &kp F2       &kp F3       &kp F4       &kp F5           &kp F6     &kp F7     &kp F8     &kp F9     &kp F10
    &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3     &trans     &trans     &trans     &trans     &kp F11
    &trans     &trans       &trans       &trans       &trans           &trans     &trans     &trans     &trans     &kp F12
    &sys_reset &trans       &trans       &trans                        &trans     &trans     &trans     &trans
    &trans                                                                        &trans     &trans     &trans     &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};