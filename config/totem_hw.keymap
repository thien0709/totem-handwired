#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <&kp A>;
            
            // Test encoder - xoay sẽ gõ chữ B và C
            sensor-bindings = <&inc_dec_kp B C>;
        };
    };
};