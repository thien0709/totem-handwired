#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <50>;
            key-positions = <16 17>; // J + K = Esc
            bindings = <&kp ESC>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <ADJ>;
        };
    };

    behaviors {
        // Giữ = Ctrl, Nhấp = Esc
        mt_ctrl_esc: mt_ctrl_esc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        // Giữ = Shift, Nhấp = Enter
        mt_shift_ret: mt_shift_ret {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

/*
 * LAYER 0: BASE (QWERTY for Coding)
 * SỬA LỖI: Đã thêm 'ESC' vào sau LCTRL
 */
        base_layer {
            display-name = "Base";
            bindings = <
    &kp Q          &kp W      &kp E       &kp R       &kp T           &kp Y      &kp U      &kp I       &kp O      &kp P
    &kp A          &kp S      &kp D       &kp F       &kp G           &kp H      &kp J      &kp K       &kp L      &kp SEMI
    &kp Z          &kp X      &kp C       &kp V       &kp B           &kp N      &kp M      &kp COMMA   &kp DOT    &kp FSLH
                   &mt_ctrl_esc LCTRL ESC  &mo NAV     &kp SPACE       &mt_shift_ret RSHIFT RET    &mo SYM    &kp BSPC
    &kp C_MUTE &kp C_PP
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

/*
 * LAYER 1: NAV
 */
        nav_layer {
            display-name = "Nav";
            bindings = <
    &kp N1     &kp N2     &kp N3      &kp N4      &kp N5          &kp N6     &kp N7     &kp N8      &kp N9     &kp N0
    &trans     &trans     &trans      &trans      &trans          &kp LEFT   &kp DOWN   &kp UP      &kp RIGHT  &kp COLON
    &trans     &trans     &trans      &trans      &trans          &kp HOME   &kp PG_DN  &kp PG_UP   &kp END    &kp BSLH
                          &trans      &trans      &trans          &trans     &trans     &kp DEL
    &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

/*
 * LAYER 2: SYM
 */
        sym_layer {
            display-name = "Sym";
            bindings = <
    &kp EXCL   &kp AT     &kp HASH    &kp DLLR    &kp PRCNT       &kp CARET  &kp AMPS   &kp STAR    &kp LPAR   &kp RPAR
    &kp TILDE  &kp MINUS  &kp PLUS    &kp EQUAL   &kp UNDER       &kp LBRC   &kp RBRC   &kp LBKT    &kp RBKT   &kp SQT
    &kp GRAVE  &trans     &trans      &trans      &trans          &kp LT     &kp GT     &trans      &trans     &kp DQT
                          &trans      &trans      &trans          &trans     &trans     &trans
    &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

/*
 * LAYER 3: ADJ
 */
        adj_layer {
            display-name = "Adj";
            bindings = <
    &kp F1        &kp F2        &kp F3        &kp F4        &kp F5           &kp F6        &kp F7        &kp F8        &kp F9        &kp F10
    &bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3     &out OUT_TOG  &trans        &trans        &trans        &kp F11
    &sys_reset    &trans        &trans        &trans        &trans           &trans        &trans        &trans        &trans        &kp F12
                                &trans        &trans        &trans           &trans        &trans        &trans
    &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };
    };
};